{
  "name": "foodhive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "playwright:install": "playwright install chromium",
    "discover:grubcenter": "dotenv -e .env.local -- tsx scraper/discover.ts",
    "sync:once": "dotenv -e .env.local -- tsx scraper/sync.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "amazon-cognito-identity-js": "^6.3.20",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "next": "16.3.4",
    "officecrypto-tool": "^0.0.19",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
